msgstr "Préfixe recommandé : %s"

#: view/custom-ontology/ns/browse.phtml:27
#: view/custom-ontology/ns/show.phtml:28
#, php-format
msgid ""
"%1$shuman%2$s | %3$sturtle%2$s | %4$sjson-ld%2$s | %5$sn3%2$s | %6$sn-"
"triples%2$s | %7$srdf-xml%2$s"
msgstr ""
"%1$slisible%2$s | %3$sturtle%2$s | %4$sjson-ld%2$s | %5$sn3%2$s | %6$sn-"
"triples%2$s | %7$srdf-xml%2$s"

#: view/custom-ontology/ns/browse.phtml:39
#: view/custom-ontology/ns/show.phtml:37
msgid "HTTP Content-Negociation is supported."
msgstr "Le « HTTP Content-Negociation » est prise en charge."

