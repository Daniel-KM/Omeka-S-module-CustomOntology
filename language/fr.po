msgstr ""
"Un préfixe est insiqué pour cette ontologie, mais aucune uri d’espace de nom."

#: src/Controller/Admin/CustomOntologyController.php:366
msgid "The namespace uri must end with \"/\" or \"#\"."
msgstr "L’uri de l’espace de noms doit se terminer par « / » ou « # »."

#: src/Controller/Admin/CustomOntologyController.php:370
