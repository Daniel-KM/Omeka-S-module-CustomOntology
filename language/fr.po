#: src/Controller/Admin/CustomOntologyController.php:566
#, php-format
msgid ""
"%s: The local name part of the term \"%s\" must start with a lower-case "
"letter."
msgstr ""
"%s : la partie nom local du terme \"%s\" doit commencer par une minuscule."

#: src/Controller/Admin/CustomOntologyController.php:584
#, php-format
msgid ""
"%s: The term \"%s\" must start with an alphabetic character and contain only "
