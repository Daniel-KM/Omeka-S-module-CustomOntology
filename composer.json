{
    "name": "daniel-km/omeka-s-module-custom-ontology",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Create specific classes and properties to describe resources when no standard ontologies can be used.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "ontology",
        "vocabulary",
        "class",
        "property"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-CustomOntology",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-CustomOntology/-/work_items",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2432)": {
        "omeka/omeka-s": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "CustomOntology\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CustomOntologyTest\\": "tests/CustomOntologyTest/"
        }
    },
    "extra": {
        "installer-name": "CustomOntology"
    }
}
